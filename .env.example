POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://jarvis:change-me@db:5432/jarvis
API_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
LUMA_DELIVERY_ROOT=/data/delivery
LUMA_DEPLOY_ROOT=/data/deploy
AI_PROVIDER=local
AI_MODEL=
AI_API_KEY=

# Set in any non-local deployment. Leave blank for local development.
LUMA_API_KEY=


# Self-hosted user authentication. Generate a strong random auth secret.
LUMA_AUTH_SECRET=
LUMA_AUTH_TOKEN_TTL_SECONDS=3600
# Optional first owner bootstrap. Use a scrypt hash, never a plaintext password.
LUMA_ADMIN_EMAIL=
LUMA_ADMIN_PASSWORD_HASH=

# Provider credentials should be supplied through your secret manager.
# These placeholders are documentation only; do not commit real credentials.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# HUBSPOT_ACCESS_TOKEN=
# CALENDLY_ACCESS_TOKEN=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TELNYX_API_KEY=
# STRIPE_SECRET_KEY=


# Secret manager. Production should use Infisical; environment fallback is for local development only.
INFISICAL_URL=http://infisical:8080
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=prod
INFISICAL_SECRET_PATH=/luma

# Distributed API rate limiting (PostgreSQL-backed)
LUMA_RATE_LIMIT_PER_MINUTE=120
LUMA_RATE_LIMIT_AUTH_PER_MINUTE=10
LUMA_RATE_LIMIT_OAUTH_PER_MINUTE=30
LUMA_RATE_LIMIT_FAIL_CLOSED=true


# Voice / telephony. Calls are optional; email remains the canonical async path.
# Use E.164 numbers, e.g. +15551234567.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
LUMA_VOICE_PUBLIC_URL=https://your-public-api.example.com
LUMA_VOICE_STREAM_URL=wss://your-public-api.example.com/voice/stream
LUMA_VOICE_TWIML_URL=https://your-public-api.example.com/voice/twilio/incoming
LUMA_TWILIO_VOICE=Polly.Joanna-Neural

# Realtime speech provider. Keep provider/model configurable.
LUMA_REALTIME_API_KEY=
LUMA_REALTIME_URL=wss://api.openai.com/v1/realtime
LUMA_REALTIME_MODEL=gpt-realtime-2.1
LUMA_REALTIME_VOICE=marin
# Development-only emergency override; production should leave false.
LUMA_VOICE_ALLOW_UNSIGNED_WEBHOOKS=false

# Optional secret-manager reference for Twilio. If blank, local env credentials may be used.
LUMA_TWILIO_SECRET_REF=
LUMA_VOICE_MAX_DURATION_SECONDS=1800
LUMA_VOICE_POST_CALL_SUMMARY=true
LUMA_VOICE_REQUIRE_CONSENT=true
