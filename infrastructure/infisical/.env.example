# Copy to .env and generate unique values before startup.
SITE_URL=http://127.0.0.1:8080
ENCRYPTION_KEY=
AUTH_SECRET=

POSTGRES_USER=infisical
POSTGRES_PASSWORD=
POSTGRES_DB=infisical
DB_CONNECTION_URI=postgres://infisical:CHANGE_ME@db:5432/infisical
REDIS_URL=redis://redis:6379

# For production: put Infisical behind Luma's HTTPS reverse proxy,
# disable public signup after bootstrap, back up Postgres and ENCRYPTION_KEY,
# and pin a tested Infisical image version instead of using latest-postgres.
